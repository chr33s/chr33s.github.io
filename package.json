{
	"name": "@chr33s/portfolio",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"npm": ">=9.0.0",
		"node": ">=20.0.0"
	},
	"type": "module",
	"scripts": {
		"prebuild": "npm run checks",
		"build": "vite build",
		"checks": "npm-run-all typecheck format lint",
		"dev": "npm-run-all --parallel dev:*",
		"dev:client": "vite build --watch",
		"dev:server": "wrangler pages dev --compatibility-date=2024-08-01 --live-reload --port=8080 ./dist",
		"deploy": "export $(cat .env.production | xargs); npm run build && wrangler pages publish ./dist --project-name chr33s --branch main && git push",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{css,ts,tsx,md}\"",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"upgrade": "npm-check-updates --install=always --silent --upgrade && npm audit fix && npm run build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20240725.0",
		"@eslint/js": "9.8.0",
		"@heroicons/react": "2.1.5",
		"@tailwindcss/forms": "0.5.7",
		"@types/node": "22.0.2",
		"@types/postcss-import": "14.0.3",
		"@types/react": "18.3.3",
		"@types/react-dom": "18.3.0",
		"@vitejs/plugin-react": "4.3.1",
		"autoprefixer": "10.4.19",
		"clsx": "2.1.1",
		"cssnano": "7.0.4",
		"eslint": "9.8.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-react": "7.35.0",
		"eslint-plugin-tailwindcss": "3.17.4",
		"npm-check-updates": "17.0.0",
		"npm-run-all": "4.1.5",
		"postcss": "8.4.40",
		"postcss-import": "16.1.0",
		"postcss-preset-env": "9.6.0",
		"prettier": "3.3.3",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"tailwindcss": "3.4.7",
		"ts-node": "10.9.2",
		"typescript": "5.5.4",
		"typescript-eslint": "8.0.0",
		"vite": "5.3.5",
		"vitest": "2.0.5",
		"wrangler": "3.68.0"
	},
	"prettier": {
		"overrides": [
			{
				"files": "*.svg",
				"options": {
					"parser": "html"
				}
			}
		]
	}
}
