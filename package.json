{
	"name": "@chr33s/portfolio",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "npm run checks",
		"build": "vp build",
		"checks": "vp check --fix && npm run typecheck",
		"dev": "vp dev --port=8080",
		"preview": "vp preview",
		"deploy": "export $(cat .env.production | xargs); npm run build && wrangler deploy && git push",
		"lint": "vp lint",
		"format": "vp fmt --write",
		"test": "vp test",
		"typecheck": "tsc --noEmit",
		"upgrade": "npm-check-updates --install=always --silent --upgrade && npm audit fix && npm run build"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.51.1",
		"@heroicons/react": "2.2.0",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"clsx": "2.1.1",
		"npm-check-updates": "23.0.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite-plus": "0.2.8",
		"wrangler": "4.120.0"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"workerd": true
	}
}
